---
const benefits = [
  ["Personalização com carinho", "Cada peça nasce a partir da sua ideia, com arte, nome, foto ou frase."],
  ["Opções para todos os estilos", "Do presente romântico ao criativo, você escolhe o formato que combina com o casal."],
  ["Atendimento pelo WhatsApp", "A conversa é direta, simples e humana para ajustar detalhes antes de produzir."],
  ["Produção artesanal", "Feito sob encomenda, com cuidado no acabamento e na apresentação."],
];
---

<section class="px-4 py-12 sm:px-6 lg:px-8" aria-labelledby="beneficios-title">
  <div class="mx-auto max-w-7xl">
    <h2 id="beneficios-title" class="sr-only">Benefícios dos presentes personalizados</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map(([title, text]) => (
        <article class="rounded-2xl border border-[#E1B78F]/65 bg-white/55 p-5 shadow-sm">
          <div class="mb-4 h-1.5 w-14 rounded-full bg-[#F5A728]"></div>
          <h3 class="text-lg font-black text-[#703D25]">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-[#6f4a35]">{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
