---
const highlights = [
  "Escolha as bebidas e guloseimas favoritas do seu par.",
  "Inclua itens decorativos que são a cara do casal.",
  "Complete com produtos personalizados exclusivos.",
  "Finalize pelo WhatsApp com atendimento próximo e humano.",
];
---

<section
  class="border-y border-[#E1B78F]/70 bg-white/48 px-4 py-14 sm:px-6 lg:px-8"
>
  <div
    class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
  >
    <div
      class="reveal reveal-left relative overflow-hidden rounded-[2rem] bg-[#703D25] shadow-xl shadow-[#703D25]/10 group"
    >
      <img
        src="/assets/valentines-2026/caneca-cesta.webp"
        alt="Cesta personalizada de Dia dos Namorados com mimos e presentes artesanais"
        class="aspect-square w-full object-cover opacity-95 transition-transform duration-700 ease-out group-hover:scale-105"
        width="720"
        height="720"
        loading="lazy"
      />
      <div
        class="absolute left-5 top-5 rounded-full bg-[#F5A728] px-4 py-2 text-sm font-black text-[#703D25] transition hover:scale-105"
      >
        Feita sob encomenda
      </div>
    </div>

    <div class="reveal reveal-right flex flex-col justify-center">
      <p class="text-sm font-black uppercase tracking-[0.18em] text-[#C06445]">
        Cesta personalizada
      </p>
      <h2
        class="mt-3 text-3xl font-black leading-tight text-[#703D25] sm:text-4xl"
      >
        Um presente completo, bonito de entregar e fácil de personalizar.
      </h2>
      <p class="mt-4 text-base leading-7 text-[#6f4a35]">
        A cesta reúne sabores, lembranças e detalhes artesanais em um só pedido.
        Ela pode ser romântica, delicada, divertida ou cheia de referências do
        casal.
      </p>

      <div class="mt-6 grid gap-3">
        {
          highlights.map((highlight) => (
            <div class="flex gap-3 rounded-2xl bg-[#FBEEDE] p-3 text-sm font-bold leading-6 text-[#703D25] transition hover:bg-[#FBEEDE]/90 hover:translate-x-1 duration-300">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#C06445]" />
              <span>{highlight}</span>
            </div>
          ))
        }
      </div>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full bg-[#C06445] px-6 text-base font-black text-white transition-all duration-300 hover:-translate-y-1 hover:bg-[#a94f34] hover:shadow-lg hover:shadow-[#C06445]/20"
          href="#cesta"
        >
          Escolher itens da cesta
        </a>
      </div>
    </div>
  </div>
</section>
