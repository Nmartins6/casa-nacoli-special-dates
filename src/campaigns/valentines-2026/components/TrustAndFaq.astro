---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="reveal reveal-up">
      <SectionHeading
        eyebrow="Confiança"
        title="Um pedido simples, próximo e feito com cuidado"
        description="A compra acontece pelo WhatsApp para manter o atendimento humano e facilitar ajustes importantes antes da produção."
        align="center"
      />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        trustItems.map(([title, text], idx) => (
          <article
            class={`reveal reveal-up delay-${(idx + 1) * 100} rounded-2xl border border-[#E1B78F]/70 bg-white/65 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:bg-white`}
          >
            <h3 class="font-black text-[#703D25]">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-[#6f4a35]">{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="overflow-hidden px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="reveal reveal-up">
      <SectionHeading
        eyebrow="Depoimentos"
        title="O que nossos clientes dizem"
        align="center"
      />
    </div>

    <div class="reveal reveal-up delay-200 relative mt-10">
      <div id="testimonials-viewport" class="overflow-hidden">
        <div
          id="testimonials-track"
          class="flex gap-4 transition-transform duration-700 ease-in-out will-change-transform"
        >
          {
            [...testimonials, ...testimonials].map((t, i) => (
              <article
                class="testimonial-card flex flex-col shrink-0 rounded-2xl border border-[#E1B78F]/70 bg-[#FBEEDE]/70 p-5 transition-all duration-300 hover:shadow-md hover:bg-white/80"
                aria-hidden={i >= testimonials.length ? "true" : "false"}
              >
                <div class="flex gap-0.5" aria-label={`${t.stars} estrelas`}>
                  {Array.from({ length: t.stars }).map(() => (
                    <svg
                      class="h-4 w-4 fill-[#F5A728]"
                      viewBox="0 0 20 20"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.286 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.175 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69L9.049 2.927z" />
                    </svg>
                  ))}
                </div>

                <blockquote class="mt-3 text-sm leading-6 text-[#703D25]">
                  "{t.comment}"
                </blockquote>

                <figcaption class="mt-auto pt-3 text-xs font-black text-[#C06445]">
                  {t.name}
                </figcaption>
              </article>
            ))
          }
        </div>
      </div>

      <div
        id="testimonials-dots"
        class="mt-6 flex justify-center gap-2"
        aria-label="Navegação do carrossel"
      >
        {
          testimonials.map((_, i) => (
            <button
              class="testimonial-dot h-2 w-2 rounded-full bg-[#E1B78F] transition-all duration-300 focus-ring"
              data-index={i}
              aria-label={`Ir para depoimento ${i + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const viewport = document.getElementById(
    "testimonials-viewport",
  ) as HTMLElement;
  const track = document.getElementById("testimonials-track") as HTMLElement;
  const dots = document.querySelectorAll<HTMLButtonElement>(".testimonial-dot");

  if (track && viewport) {
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>(".testimonial-card"),
    );
    const total = dots.length;
    const GAP = 16;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    const getVisible = () => {
      if (window.innerWidth >= 1024) return 4;
      if (window.innerWidth >= 640) return 2;
      return 1;
    };

    const setCardWidths = () => {
      const containerW = viewport.clientWidth;
      const visible = getVisible();
      const cardW = Math.floor((containerW - GAP * (visible - 1)) / visible);
      cards.forEach((card) => {
        card.style.width = `${cardW}px`;
        card.style.minWidth = `${cardW}px`;
      });
    };

    const getCardWidth = () => cards[0]?.getBoundingClientRect().width ?? 0;

    const setActive = (index: number) => {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-[#C06445]", i === index);
        dot.classList.toggle("w-5", i === index);
        dot.classList.toggle("bg-[#E1B78F]", i !== index);
        dot.classList.toggle("w-2", i !== index);
      });
    };

    const goTo = (index: number) => {
      current = ((index % total) + total) % total;
      const offset = current * (getCardWidth() + GAP);
      track.style.transform = `translateX(-${offset}px)`;
      setActive(current);

      if (current === 0) {
        setTimeout(() => {
          track.style.transition = "none";
          track.style.transform = `translateX(0)`;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              track.style.transition = "";
            }),
          );
        }, 700);
      }
    };

    const next = () => goTo(current + 1);

    const startTimer = () => {
      clearInterval(timer);
      timer = setInterval(next, 3000);
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        goTo(i);
        startTimer();
      });
    });

    track.addEventListener("mouseenter", () => clearInterval(timer));
    track.addEventListener("mouseleave", startTimer);

    let touchStartX = 0;
    track.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    track.addEventListener(
      "touchend",
      (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) {
          goTo(diff > 0 ? current + 1 : current - 1);
          startTimer();
        }
      },
      { passive: true },
    );

    window.addEventListener(
      "resize",
      () => {
        setCardWidths();
        goTo(current);
      },
      { passive: true },
    );

    setCardWidths();
    setActive(0);
    startTimer();
  }
</script>

<section id="faq" class="px-4 pb-28 pt-6 sm:px-6 lg:px-8 lg:pb-16">
  <div class="mx-auto max-w-4xl">
    <div class="reveal reveal-up">
      <SectionHeading
        eyebrow="FAQ"
        title="Dúvidas rápidas antes de pedir"
        align="center"
      />
    </div>
    <div
      class="reveal reveal-up delay-200 mt-8 divide-y divide-[#E1B78F] overflow-hidden rounded-2xl border border-[#E1B78F] bg-white/72"
    >
      {
        faqs.map(([question, answer]) => (
          <details class="group p-5 transition-colors duration-300 hover:bg-[#FBEEDE]/25">
            <summary class="cursor-pointer list-none text-base font-black text-[#703D25] focus:outline-none">
              <span class="inline-flex w-full items-center justify-between gap-4">
                {question}
                <span class="shrink-0 text-xl font-black text-[#C06445] transition-transform duration-300 group-open:rotate-180">
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-[#6f4a35]">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
