---
import SectionHeading from "@shared/components/SectionHeading.astro";

const trustItems = [
  ["Atendimento personalizado", "Você conversa direto com a Casa Nacoli para acertar arte, quantidades e acabamento."],
  ["Feito sob encomenda", "Cada pedido é preparado para aquela pessoa, aquela história e aquele momento."],
  ["Produção com cuidado", "O foco é entregar presentes bonitos, afetivos e bem apresentados."],
  ["Ideal para surpreender", "A campanha foi pensada para presentes criativos para casal, cestas e lembranças românticas."],
];

const testimonials = [
  {
    name: "Cliente placeholder",
    text: "A caneca ficou delicada e a cesta veio do jeitinho que eu imaginei.",
  },
  {
    name: "Cliente placeholder",
    text: "Gostei de poder resolver tudo pelo WhatsApp e ajustar a arte antes de finalizar.",
  },
];

const faqs = [
  ["Posso escolher a arte?", "Sim. Você pode enviar foto, frase, nome, data ou referência. A Casa Nacoli confirma os detalhes antes da produção."],
  ["Quanto tempo leva para produzir?", "O prazo depende do produto, da quantidade e da agenda da campanha. O tempo certinho é confirmado pelo WhatsApp."],
  ["Posso montar uma cesta personalizada?", "Pode. Você seleciona os itens no site e também pode pedir algo que não apareceu na lista."],
  ["Como finalizo o pedido?", "Monte seu carrinho, preencha nome e observações, e envie tudo pelo botão de WhatsApp."],
  ["Vocês entregam ou é retirada?", "As opções de entrega ou retirada são combinadas diretamente no atendimento."],
  ["Posso pedir pelo WhatsApp?", "Sim. O WhatsApp é o canal principal para confirmar arte, valores, prazo e forma de entrega."],
];
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow="Confiança"
      title="Um pedido simples, próximo e feito com cuidado"
      description="A compra acontece pelo WhatsApp para manter o atendimento humano e facilitar ajustes importantes antes da produção."
      align="center"
    />

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {trustItems.map(([title, text]) => (
        <article class="rounded-2xl border border-[#E1B78F]/70 bg-white/65 p-5">
          <h3 class="font-black text-[#703D25]">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-[#6f4a35]">{text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {testimonials.map((testimonial) => (
        <figure class="rounded-2xl border border-[#E1B78F]/70 bg-[#FBEEDE]/70 p-5">
          <blockquote class="text-base font-semibold leading-7 text-[#703D25]">
            “{testimonial.text}”
          </blockquote>
          <figcaption class="mt-3 text-sm font-bold text-[#C06445]">
            {testimonial.name} - depoimento fictício para placeholder
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="faq" class="px-4 pb-28 pt-6 sm:px-6 lg:px-8 lg:pb-16">
  <div class="mx-auto max-w-4xl">
    <SectionHeading eyebrow="FAQ" title="Dúvidas rápidas antes de pedir" align="center" />
    <div class="mt-8 divide-y divide-[#E1B78F] overflow-hidden rounded-2xl border border-[#E1B78F] bg-white/72">
      {faqs.map(([question, answer]) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none text-base font-black text-[#703D25]">
            <span class="inline-flex w-full items-center justify-between gap-4">
              {question}
              <span class="text-xl text-[#C06445] group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-6 text-[#6f4a35]">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
