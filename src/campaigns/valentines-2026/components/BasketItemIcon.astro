---
type Props = {
  itemId: string;
};

const { itemId } = Astro.props;
---

<span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-white/20 bg-[#FBEEDE] text-[#703D25] shadow-sm" aria-hidden="true">
  <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {itemId === "vinho" && (
      <>
        <path d="M7 3h6" />
        <path d="M8 3v5l-2 3v8a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-8l-2-3V3" />
        <path d="M7 14h7" />
        <path d="M17 10h4l-1 5a2 2 0 0 1-4 0Z" />
        <path d="M18.5 17v4" />
      </>
    )}
    {itemId === "cerveja" && (
      <>
        <path d="M5 8h10v10a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3Z" />
        <path d="M15 10h2a3 3 0 0 1 0 6h-2" />
        <path d="M7 8c0-3 6-3 6 0" />
        <path d="M8 12v5" />
        <path d="M12 12v5" />
      </>
    )}
    {itemId === "chocolate" && (
      <>
        <rect x="5" y="5" width="14" height="14" rx="2" />
        <path d="M5 10h14" />
        <path d="M5 15h14" />
        <path d="M10 5v14" />
        <path d="M15 5v14" />
      </>
    )}
    {itemId === "bombons" && (
      <>
        <path d="M8 9h8v6H8z" />
        <path d="M8 10 4 8v8l4-2" />
        <path d="m16 10 4-2v8l-4-2" />
        <circle cx="10" cy="12" r="1" />
        <circle cx="14" cy="12" r="1" />
      </>
    )}
    {itemId === "bolacha" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="9" cy="10" r=".8" />
        <circle cx="14" cy="9" r=".8" />
        <circle cx="13" cy="14" r=".8" />
        <circle cx="9.5" cy="15" r=".8" />
      </>
    )}
    {itemId === "cappuccino" && (
      <>
        <path d="M5 9h11v6a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4Z" />
        <path d="M16 11h2a3 3 0 0 1 0 6h-2" />
        <path d="M8 5c-1 1-1 2 0 3" />
        <path d="M12 5c-1 1-1 2 0 3" />
        <path d="M7 13h7" />
      </>
    )}
    {itemId === "geleias" && (
      <>
        <path d="M9 3h6" />
        <path d="M10 6h4" />
        <path d="M7 10a5 5 0 0 1 10 0v8a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3Z" />
        <path d="M8 14h8" />
        <path d="M10 17h4" />
      </>
    )}
    {itemId === "balao-coracao" && (
      <>
        <path d="M12 15s-5-3-5-7a3 3 0 0 1 5-2 3 3 0 0 1 5 2c0 4-5 7-5 7Z" />
        <path d="M12 15c0 3-3 3-3 6" />
        <path d="M12 15c0 2 3 2 3 5" />
      </>
    )}
    {itemId === "cookies" && (
      <>
        <circle cx="10" cy="10" r="5" />
        <circle cx="14" cy="14" r="5" />
        <circle cx="9" cy="9" r=".7" />
        <circle cx="13" cy="13" r=".7" />
        <circle cx="16" cy="15" r=".7" />
      </>
    )}
    {itemId === "sucos" && (
      <>
        <path d="M8 5h9l-1 16H9Z" />
        <path d="M9 9h7" />
        <path d="M12 5 9 2" />
        <path d="M13 5 17 2" />
        <path d="M10 14h5" />
      </>
    )}
    {itemId === "vela" && (
      <>
        <path d="M12 3s2 2 2 4a2 2 0 1 1-4 0c0-2 2-4 2-4Z" />
        <path d="M8 11h8v9H8Z" />
        <path d="M9 15h6" />
        <path d="M10 20h4" />
      </>
    )}
    {itemId === "nutella" && (
      <>
        <path d="M8 4h8" />
        <path d="M9 7h6" />
        <path d="M7 10h10v8a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3Z" />
        <path d="M8 14h8" />
        <path d="M10 18v-3l4 3v-3" />
      </>
    )}
    {itemId === "caneca-personalizada" && (
      <>
        <path d="M5 8h11v7a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4Z" />
        <path d="M16 10h2a3 3 0 0 1 0 6h-2" />
        <path d="M10.5 12c1-1.5 3.5-.8 3.5 1.1 0 1.4-1.7 2.4-3.5 3.4-1.8-1-3.5-2-3.5-3.4 0-1.9 2.5-2.6 3.5-1.1Z" />
      </>
    )}
    {itemId === "foto-impressa" && (
      <>
        <rect x="4" y="5" width="16" height="14" rx="2" />
        <path d="m4 16 4-4 4 4 3-3 5 5" />
        <circle cx="15" cy="9" r="1.5" />
        <path d="M8 21h8" />
      </>
    )}
    {itemId === "impressao-personalizada" && (
      <>
        <path d="M7 3h7l4 4v14H7Z" />
        <path d="M14 3v5h5" />
        <path d="M10 12h5" />
        <path d="M10 16h4" />
        <path d="M8 6h2" />
      </>
    )}
    {itemId === "azulejo-personalizado" && (
      <>
        <rect x="5" y="4" width="14" height="14" rx="2" />
        <path d="M5 11h14" />
        <path d="M12 4v14" />
        <path d="M9 21h6" />
        <path d="M12 18v3" />
      </>
    )}
    {![
      "vinho",
      "cerveja",
      "chocolate",
      "bombons",
      "bolacha",
      "cappuccino",
      "geleias",
      "balao-coracao",
      "cookies",
      "sucos",
      "vela",
      "nutella",
      "caneca-personalizada",
      "foto-impressa",
      "impressao-personalizada",
      "azulejo-personalizado",
    ].includes(itemId) && (
      <>
        <path d="M4 10h16v10H4Z" />
        <path d="M4 10h16" />
        <path d="M12 10v10" />
        <path d="M8 7c0-2 4-2 4 3 0-5 4-5 4-3 0 3-4 3-4 3s-4 0-4-3Z" />
      </>
    )}
