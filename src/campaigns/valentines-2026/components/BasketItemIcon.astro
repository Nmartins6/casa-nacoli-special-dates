---
import {
  Beer,
  Candy,
  Coffee,
  Cookie,
  CupSoda,
  FileText,
  Flame,
  Heart,
  Image,
  Table,
  Nut,
  WavesVertical,
  Wine,
  Square,
  type IconProps,
} from "@lucide/astro";

type Props = {
  itemId: string;
};

const { itemId } = Astro.props;

const iconMap: Record<string, (props: IconProps) => unknown> = {
  vinho: Wine,
  cerveja: Beer,
  chocolate: Table,
  bombons: Candy,
  guloseimas: Cookie,
  cappuccino: Coffee,
  geleias: WavesVertical,
  "balao-coracao": Heart,
  cookies: Cookie,
  sucos: CupSoda,
  vela: Flame,
  nutella: Nut,
  "caneca-personalizada": Coffee,
  "foto-impressa": Image,
  "impressao-personalizada": FileText,
  "azulejo-personalizado": Square,
};

const Icon = iconMap[itemId]
---

<span class="relative grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-white/20 bg-[#FBEEDE] text-[#703D25] shadow-sm" aria-hidden="true">
  <Icon class="h-7 w-7" stroke-width={1.8} />
</span>
