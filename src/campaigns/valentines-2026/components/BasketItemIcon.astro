---
type Props = {
  itemId: string;
};

const { itemId } = Astro.props;

const drinkIds = ["vinho", "cerveja", "sucos"];
const sweetIds = ["chocolate", "bombons", "cookies", "bolacha", "nutella"];
const jarIds = ["geleias"];
const cupIds = ["cappuccino", "caneca-personalizada"];
const iconType = drinkIds.includes(itemId)
  ? "drink"
  : sweetIds.includes(itemId)
    ? "sweet"
    : jarIds.includes(itemId)
      ? "jar"
      : cupIds.includes(itemId)
        ? "cup"
        : itemId === "balao-coracao"
          ? "heart"
          : itemId === "vela"
            ? "candle"
            : itemId === "foto-impressa"
              ? "photo"
              : itemId === "impressao-personalizada"
                ? "paper"
                : itemId === "azulejo-personalizado"
                  ? "tile"
                  : "gift";
---

<span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-white/20 bg-[#FBEEDE] text-[#703D25] shadow-sm" aria-hidden="true">
  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {iconType === "drink" && (
      <>
        <path d="M10 3h4" />
        <path d="M11 3v5l-3 4v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-7l-3-4V3" />
        <path d="M9 14h6" />
      </>
    )}
    {iconType === "sweet" && (
      <>
        <path d="M8 8h8v8H8z" />
        <path d="M8 10 4 8v8l4-2" />
        <path d="m16 10 4-2v8l-4-2" />
        <path d="M10 12h4" />
      </>
    )}
    {iconType === "jar" && (
      <>
        <path d="M9 3h6" />
        <path d="M10 6h4" />
        <path d="M7 10a5 5 0 0 1 10 0v8a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3z" />
        <path d="M8 14h8" />
      </>
    )}
    {iconType === "cup" && (
      <>
        <path d="M5 8h11v7a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z" />
        <path d="M16 10h2a3 3 0 0 1 0 6h-2" />
        <path d="M8 5v1" />
        <path d="M12 5v1" />
      </>
    )}
    {iconType === "heart" && (
      <>
        <path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z" />
        <path d="M12 8V3" />
      </>
    )}
    {iconType === "candle" && (
      <>
        <path d="M12 3s2 2 2 4a2 2 0 1 1-4 0c0-2 2-4 2-4Z" />
        <path d="M8 11h8v9H8z" />
        <path d="M10 15h4" />
      </>
    )}
    {iconType === "photo" && (
      <>
        <rect x="4" y="5" width="16" height="14" rx="2" />
        <path d="m4 16 4-4 4 4 3-3 5 5" />
        <circle cx="15" cy="9" r="1.5" />
      </>
    )}
    {iconType === "paper" && (
      <>
        <path d="M7 3h7l4 4v14H7z" />
        <path d="M14 3v5h5" />
        <path d="M10 12h5" />
        <path d="M10 16h5" />
      </>
    )}
    {iconType === "tile" && (
      <>
        <rect x="5" y="5" width="14" height="14" rx="2" />
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </>
    )}
    {iconType === "gift" && (
      <>
        <path d="M4 10h16v10H4z" />
        <path d="M4 10h16" />
        <path d="M12 10v10" />
        <path d="M8 7c0-2 4-2 4 3 0-5 4-5 4-3 0 3-4 3-4 3s-4 0-4-3Z" />
      </>
    )}
  </svg>
</span>
