---
import SectionHeading from "@shared/components/SectionHeading.astro";
import type { BasketItem } from "@shared/types/campaign";
import { campaign } from "../data/campaign";
import { createWhatsAppLink, formatOrderMessage } from "@shared/utils/whatsapp";
import BasketItemIcon from "./BasketItemIcon.astro";

type Props = {
  items: BasketItem[];
};

const { items } = Astro.props;
const customRequestMessage = formatOrderMessage({
  customerName: "",
  notes:
    "Vim pelo site e quero montar uma cesta personalizada com um item que não encontrei na lista.",
  products: [],
  basketItems: [],
});
const customRequestUrl = createWhatsAppLink(campaign.whatsappNumber, customRequestMessage);
---

<section id="cesta" class="bg-[#703D25] px-4 py-16 text-white sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <SectionHeading
          eyebrow="Monte agora"
          title="Selecione os itens ideais. A gente cuida dos detalhes com você."
          description="Selecione doces, bebidas, mimos e itens personalizados para compor a surpresa à sua maneira. Depois confirmamos disponibilidade, acabamento, valores e possibilidades de arte antes da produção."
          tone="dark"
        />
        <div class="mt-6 rounded-3xl border border-white/15 bg-white/10 p-5 shadow-2xl shadow-black/10 backdrop-blur">
          <p class="text-sm font-semibold leading-6 text-[#FBEEDE]">
            A cesta pode receber complementos personalizados, como canecas, quadros em MDF, imãs de geladeira, entre outros produtos que já são conhecidos pelos nossos clientes.
          </p>

          <div class="mt-5 grid gap-3">
            <a
              id="basket-finish-order"
              class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full bg-[#F5A728] px-5 text-center text-sm font-black text-[#703D25] opacity-55 transition hover:-translate-y-0.5 aria-disabled:pointer-events-none aria-disabled:cursor-not-allowed"
              href="#"
              aria-disabled="true"
              tabindex="-1"
              target="_blank"
              rel="noreferrer"
            >
              Finalizar pedido
            </a>
            <a
              class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-white/25 bg-white/10 px-5 text-center text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-white/15"
              href={customRequestUrl}
              target="_blank"
              rel="noreferrer"
            >
              Não encontrei o que queria
            </a>
          </div>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {items.map((item) => (
          <article class="basket-card min-w-0 rounded-2xl border border-white/15 bg-white/10 p-4 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/[0.13]" data-basket-id={item.id} data-basket-name={item.name}>
            <div class="flex gap-4">
              <BasketItemIcon itemId={item.id} />
              <div class="min-w-0">
                <h3 class="font-black text-white">{item.name}</h3>
                <p class="mt-1 text-sm leading-5 text-[#FBEEDE]">{item.description}</p>
              </div>
            </div>
            <div class="mt-4 grid gap-3">
              <label class="flex items-center gap-3 text-sm font-bold text-white">
                <input class="basket-selected h-5 w-5 accent-[#F5A728]" type="checkbox" />
                Selecionar item
              </label>
              <label class="grid min-w-0 gap-1 text-sm font-bold text-[#FBEEDE]">
                Quantidade
                <input class="basket-quantity focus-ring min-h-11 w-full min-w-0 rounded-xl border border-white/20 bg-white px-3 text-[#703D25]" type="number" min="1" value={item.suggestedQuantity ?? 1} inputmode="numeric" />
              </label>
              <label class="grid min-w-0 gap-1 text-sm font-bold text-[#FBEEDE]">
                Observação
                <input class="basket-note focus-ring min-h-11 w-full min-w-0 rounded-xl border border-white/20 bg-white px-3 text-[#703D25]" type="text" placeholder="Ex.: sabor, marca, preferência" />
              </label>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
