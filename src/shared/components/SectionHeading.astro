---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
};

const { eyebrow, title, description, align = "left", tone = "light" } = Astro.props;
---

<div class:list={["mx-auto max-w-3xl", align === "center" ? "text-center" : ""]}>
  {eyebrow && (
    <p class:list={["mb-3 text-sm font-bold uppercase tracking-[0.18em]", tone === "dark" ? "text-[#F5A728]" : "text-[#C06445]"]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={["text-3xl font-black leading-tight sm:text-4xl", tone === "dark" ? "text-white" : "text-[#703D25]"]}>
    {title}
  </h2>
  {description && (
    <p class:list={["mt-4 text-base leading-7 sm:text-lg", tone === "dark" ? "text-[#FBEEDE]" : "text-[#6f4a35]"]}>
      {description}
    </p>
  )}
</div>
